<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<TrustFrameworkPolicy
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:xsd="http://www.w3.org/2001/XMLSchema"
  xmlns="http://schemas.microsoft.com/online/cpim/schemas/2013/06"
  PolicySchemaVersion="0.3.0.0"
  TenantId="eyehospitalpatients.onmicrosoft.com"
  PolicyId="B2C_1A_TrustFrameworkExtensions"
  PublicPolicyUri="http://eyehospitalpatients.onmicrosoft.com/B2C_1A_TrustFrameworkExtensions">

  <BasePolicy>
    <TenantId>eyehospitalpatients.onmicrosoft.com</TenantId>
    <PolicyId>B2C_1A_TrustFrameworkBase</PolicyId>
  </BasePolicy>

  <BuildingBlocks>
    <!-- Additional Claims -->
    <ClaimsSchema>
      <ClaimType Id="apiKey">
        <DisplayName>API Key</DisplayName>
        <DataType>string</DataType>
      </ClaimType>
      
      <ClaimType Id="extension_patientId">
        <DisplayName>Patient ID</DisplayName>
        <DataType>string</DataType>
      </ClaimType>
      
      <ClaimType Id="extension_medicalRecordNumber">
        <DisplayName>Medical Record Number</DisplayName>
        <DataType>string</DataType>
      </ClaimType>
    </ClaimsSchema>
  </BuildingBlocks>

  <ClaimsProviders>
    <!-- Twilio OTP REST API Provider -->
    <ClaimsProvider>
      <DisplayName>Eye Hospital OTP API</DisplayName>
      <TechnicalProfiles>
        
        <!-- Send OTP via REST API -->
        <TechnicalProfile Id="REST-SendOTP">
          <DisplayName>Send OTP via Twilio</DisplayName>
          <Protocol Name="Proprietary" Handler="Web.TPEngine.Providers.RestfulProvider, Web.TPEngine, Version=1.0.0.0, Culture=neutral, PublicKeyToken=null" />
          <Metadata>
            <!-- Update this URL when deploying to production -->
            <Item Key="ServiceUrl">https://7886148d-154a-4dfe-afa4-4975a10c9ce7-00-wed1m9226kki.picard.replit.dev:3002/api/otp/send</Item>
            <Item Key="SendClaimsIn">Body</Item>
            <Item Key="AuthenticationType">ApiKeyHeader</Item>
            <Item Key="AllowInsecureAuthInProduction">false</Item>
            <Item Key="ClaimsFormat">JSON</Item>
            <Item Key="DefaultUserMessageIfRequestFailed">Failed to send verification code. Please try again.</Item>
          </Metadata>
          <CryptographicKeys>
            <Key Id="ApiKey" StorageReferenceId="B2C_1A_EntraOtpApiKey" />
          </CryptographicKeys>
          <InputClaims>
            <InputClaim ClaimTypeReferenceId="phoneNumber" PartnerClaimType="phoneNumber" />
          </InputClaims>
          <OutputClaims>
            <OutputClaim ClaimTypeReferenceId="verificationStatus" PartnerClaimType="status" />
          </OutputClaims>
        </TechnicalProfile>

        <!-- Verify OTP via REST API -->
        <TechnicalProfile Id="REST-VerifyOTP">
          <DisplayName>Verify OTP Code</DisplayName>
          <Protocol Name="Proprietary" Handler="Web.TPEngine.Providers.RestfulProvider, Web.TPEngine, Version=1.0.0.0, Culture=neutral, PublicKeyToken=null" />
          <Metadata>
            <!-- Update this URL when deploying to production -->
            <Item Key="ServiceUrl">https://7886148d-154a-4dfe-afa4-4975a10c9ce7-00-wed1m9226kki.picard.replit.dev:3002/api/otp/verify</Item>
            <Item Key="SendClaimsIn">Body</Item>
            <Item Key="AuthenticationType">ApiKeyHeader</Item>
            <Item Key="AllowInsecureAuthInProduction">false</Item>
            <Item Key="ClaimsFormat">JSON</Item>
            <Item Key="DefaultUserMessageIfRequestFailed">Invalid or expired verification code. Please try again.</Item>
          </Metadata>
          <CryptographicKeys>
            <Key Id="ApiKey" StorageReferenceId="B2C_1A_EntraOtpApiKey" />
          </CryptographicKeys>
          <InputClaims>
            <InputClaim ClaimTypeReferenceId="phoneNumber" PartnerClaimType="phoneNumber" />
            <InputClaim ClaimTypeReferenceId="otpCode" PartnerClaimType="code" />
          </InputClaims>
          <OutputClaims>
            <OutputClaim ClaimTypeReferenceId="isValidOTP" PartnerClaimType="valid" />
            <OutputClaim ClaimTypeReferenceId="verificationStatus" PartnerClaimType="status" />
          </OutputClaims>
        </TechnicalProfile>

        <!-- Self-Asserted Phone Number Entry -->
        <TechnicalProfile Id="SelfAsserted-PhoneEntry">
          <DisplayName>Enter Phone Number</DisplayName>
          <Protocol Name="Proprietary" Handler="Web.TPEngine.Providers.SelfAssertedAttributeProvider, Web.TPEngine, Version=1.0.0.0, Culture=neutral, PublicKeyToken=null" />
          <Metadata>
            <Item Key="ContentDefinitionReferenceId">api.phoneinput</Item>
            <Item Key="setting.showContinueButton">true</Item>
            <Item Key="setting.showCancelButton">false</Item>
          </Metadata>
          <OutputClaims>
            <OutputClaim ClaimTypeReferenceId="phoneNumber" Required="true" />
          </OutputClaims>
          <ValidationTechnicalProfiles>
            <ValidationTechnicalProfile ReferenceId="REST-SendOTP" />
          </ValidationTechnicalProfiles>
        </TechnicalProfile>

        <!-- Self-Asserted OTP Entry -->
        <TechnicalProfile Id="SelfAsserted-OTPEntry">
          <DisplayName>Enter Verification Code</DisplayName>
          <Protocol Name="Proprietary" Handler="Web.TPEngine.Providers.SelfAssertedAttributeProvider, Web.TPEngine, Version=1.0.0.0, Culture=neutral, PublicKeyToken=null" />
          <Metadata>
            <Item Key="ContentDefinitionReferenceId">api.otpinput</Item>
            <Item Key="setting.showContinueButton">true</Item>
            <Item Key="setting.showCancelButton">false</Item>
          </Metadata>
          <InputClaims>
            <InputClaim ClaimTypeReferenceId="phoneNumber" />
          </InputClaims>
          <OutputClaims>
            <OutputClaim ClaimTypeReferenceId="phoneNumber" />
            <OutputClaim ClaimTypeReferenceId="otpCode" Required="true" />
          </OutputClaims>
          <ValidationTechnicalProfiles>
            <ValidationTechnicalProfile ReferenceId="REST-VerifyOTP" />
          </ValidationTechnicalProfiles>
        </TechnicalProfile>

        <!-- Self-Asserted Profile Collection (for new users) -->
        <TechnicalProfile Id="SelfAsserted-ProfileCollection">
          <DisplayName>Complete Your Profile</DisplayName>
          <Protocol Name="Proprietary" Handler="Web.TPEngine.Providers.SelfAssertedAttributeProvider, Web.TPEngine, Version=1.0.0.0, Culture=neutral, PublicKeyToken=null" />
          <Metadata>
            <Item Key="ContentDefinitionReferenceId">api.profileinput</Item>
            <Item Key="setting.showContinueButton">true</Item>
            <Item Key="setting.showCancelButton">false</Item>
          </Metadata>
          <InputClaims>
            <InputClaim ClaimTypeReferenceId="phoneNumber" />
          </InputClaims>
          <OutputClaims>
            <OutputClaim ClaimTypeReferenceId="phoneNumber" />
            <OutputClaim ClaimTypeReferenceId="givenName" Required="true" />
            <OutputClaim ClaimTypeReferenceId="surname" Required="true" />
            <OutputClaim ClaimTypeReferenceId="email" />
          </OutputClaims>
        </TechnicalProfile>
        
      </TechnicalProfiles>
    </ClaimsProvider>
  </ClaimsProviders>

  <UserJourneys>
    <!-- Phone-based Sign Up / Sign In Journey -->
    <UserJourney Id="SignUpSignInWithPhone">
      <OrchestrationSteps>
      
        <!-- Step 1: Collect Phone Number and Send OTP -->
        <OrchestrationStep Order="1" Type="ClaimsExchange">
          <ClaimsExchanges>
            <ClaimsExchange Id="PhoneEntry" TechnicalProfileReferenceId="SelfAsserted-PhoneEntry" />
          </ClaimsExchanges>
        </OrchestrationStep>

        <!-- Step 2: Collect and Verify OTP Code -->
        <OrchestrationStep Order="2" Type="ClaimsExchange">
          <ClaimsExchanges>
            <ClaimsExchange Id="OTPVerification" TechnicalProfileReferenceId="SelfAsserted-OTPEntry" />
          </ClaimsExchanges>
        </OrchestrationStep>

        <!-- Step 3: Check if User Exists -->
        <OrchestrationStep Order="3" Type="ClaimsExchange">
          <ClaimsExchanges>
            <ClaimsExchange Id="AADUserRead" TechnicalProfileReferenceId="AAD-UserReadUsingPhoneNumber" />
          </ClaimsExchanges>
        </OrchestrationStep>

        <!-- Step 4: Collect Profile Info if New User -->
        <OrchestrationStep Order="4" Type="ClaimsExchange">
          <Preconditions>
            <Precondition Type="ClaimsExist" ExecuteActionsIf="true">
              <Value>objectId</Value>
              <Action>SkipThisOrchestrationStep</Action>
            </Precondition>
          </Preconditions>
          <ClaimsExchanges>
            <ClaimsExchange Id="ProfileCollection" TechnicalProfileReferenceId="SelfAsserted-ProfileCollection" />
          </ClaimsExchanges>
        </OrchestrationStep>

        <!-- Step 5: Create User if New -->
        <OrchestrationStep Order="5" Type="ClaimsExchange">
          <Preconditions>
            <Precondition Type="ClaimsExist" ExecuteActionsIf="true">
              <Value>objectId</Value>
              <Action>SkipThisOrchestrationStep</Action>
            </Precondition>
          </Preconditions>
          <ClaimsExchanges>
            <ClaimsExchange Id="AADUserWrite" TechnicalProfileReferenceId="AAD-UserWriteUsingPhoneNumber" />
          </ClaimsExchanges>
        </OrchestrationStep>

        <!-- Step 6: Issue Token -->
        <OrchestrationStep Order="6" Type="SendClaims" CpimIssuerTechnicalProfileReferenceId="JwtIssuer" />
        
      </OrchestrationSteps>
      <ClientDefinition ReferenceId="DefaultWeb" />
    </UserJourney>

    <!-- Password Reset Journey (Phone-based) -->
    <UserJourney Id="PasswordResetWithPhone">
      <OrchestrationSteps>
        <!-- Similar steps but for password reset -->
        <OrchestrationStep Order="1" Type="ClaimsExchange">
          <ClaimsExchanges>
            <ClaimsExchange Id="PhoneEntry" TechnicalProfileReferenceId="SelfAsserted-PhoneEntry" />
          </ClaimsExchanges>
        </OrchestrationStep>

        <OrchestrationStep Order="2" Type="ClaimsExchange">
          <ClaimsExchanges>
            <ClaimsExchange Id="OTPVerification" TechnicalProfileReferenceId="SelfAsserted-OTPEntry" />
          </ClaimsExchanges>
        </OrchestrationStep>

        <!-- Additional steps for password reset would go here -->
        
        <OrchestrationStep Order="3" Type="SendClaims" CpimIssuerTechnicalProfileReferenceId="JwtIssuer" />
      </OrchestrationSteps>
      <ClientDefinition ReferenceId="DefaultWeb" />
    </UserJourney>

    <!-- Profile Edit Journey -->
    <UserJourney Id="ProfileEdit">
      <OrchestrationSteps>
        <!-- Verify identity with phone OTP first -->
        <OrchestrationStep Order="1" Type="ClaimsExchange">
          <ClaimsExchanges>
            <ClaimsExchange Id="PhoneEntry" TechnicalProfileReferenceId="SelfAsserted-PhoneEntry" />
          </ClaimsExchanges>
        </OrchestrationStep>

        <OrchestrationStep Order="2" Type="ClaimsExchange">
          <ClaimsExchanges>
            <ClaimsExchange Id="OTPVerification" TechnicalProfileReferenceId="SelfAsserted-OTPEntry" />
          </ClaimsExchanges>
        </OrchestrationStep>

        <!-- Then allow profile editing -->
        <OrchestrationStep Order="3" Type="ClaimsExchange">
          <ClaimsExchanges>
            <ClaimsExchange Id="ProfileUpdate" TechnicalProfileReferenceId="SelfAsserted-ProfileCollection" />
          </ClaimsExchanges>
        </OrchestrationStep>

        <OrchestrationStep Order="4" Type="SendClaims" CpimIssuerTechnicalProfileReferenceId="JwtIssuer" />
      </OrchestrationSteps>
      <ClientDefinition ReferenceId="DefaultWeb" />
    </UserJourney>
  </UserJourneys>

  <RelyingParty>
    <DefaultUserJourney ReferenceId="SignUpSignInWithPhone" />
    <TechnicalProfile Id="PolicyProfile">
      <DisplayName>PolicyProfile</DisplayName>
      <Protocol Name="OpenIdConnect" />
      <OutputClaims>
        <OutputClaim ClaimTypeReferenceId="displayName" />
        <OutputClaim ClaimTypeReferenceId="givenName" />
        <OutputClaim ClaimTypeReferenceId="surname" />
        <OutputClaim ClaimTypeReferenceId="email" />
        <OutputClaim ClaimTypeReferenceId="phoneNumber" />
        <OutputClaim ClaimTypeReferenceId="objectId" PartnerClaimType="sub" />
        <OutputClaim ClaimTypeReferenceId="newUser" />
      </OutputClaims>
      <SubjectNamingInfo ClaimType="sub" />
    </TechnicalProfile>
  </RelyingParty>

</TrustFrameworkPolicy>