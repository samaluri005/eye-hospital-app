modules = ["nodejs-18", "dotnet-7.0", "bash", "python-3.12", "dotnet-8.0", "postgresql-16"]
[agent]
expertMode = true
integrations = ["javascript_database:1.0.0", "twilio_send_message:1.0.0"]

[nix]
channel = "stable-25_05"
packages = ["azure-cli", "bash", "curl", "git", "gnumake", "python3", "sqlite", "redis"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Patient Portal"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "AuthService"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Redis Server"

[[workflows.workflow]]
name = "Patient Portal"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd apps/patient-portal-web && pnpm dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "AuthService"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd microservices/auth-service/AuthService && dotnet run --urls \"http://0.0.0.0:8000\""
waitForPort = 8000

[[workflows.workflow]]
name = "Redis Server"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "redis-server --bind 127.0.0.1 --port 6379"

[workflows.workflow.metadata]
outputType = "console"

[[ports]]
localPort = 3001
externalPort = 3001

[[ports]]
localPort = 3002
externalPort = 3002

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 8000
externalPort = 8000

[[ports]]
localPort = 39029
externalPort = 4200

[[ports]]
localPort = 39871
externalPort = 3003

[[ports]]
localPort = 40179
externalPort = 5173

[[ports]]
localPort = 45787
externalPort = 3000

[[ports]]
localPort = 46269
externalPort = 5000

[deployment]
deploymentTarget = "autoscale"
run = ["pnpm", "dev:patient-portal"]
build = ["pnpm", "build"]
